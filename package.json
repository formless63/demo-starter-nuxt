{
  "name": "nuxt-full-stack-starter",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "bun run lint && bun run typecheck && bun test && bun run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:provision": "bun scripts/provision-oidc.ts",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "4.0.1",
    "@tabler/icons-vue": "3.48.0",
    "@tailwindcss/vite": "4.3.3",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "nuxt": "4.5.2",
    "postgres": "3.4.9",
    "reka-ui": "2.10.5",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "vue": "3.5.43",
    "vue-sonner": "2.0.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.3.2",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.1",
    "happy-dom": "20.0.11",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "vue-tsc": "3.1.7"
  }
}
