# Server-only: PostgreSQL connection and Better Auth signing secret (32+ characters)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nuxt_starter
NUXT_AUTH_SECRET=replace-with-a-random-value-at-least-32-characters-long
# Public origin used for OAuth callbacks (GitHub callback: /api/auth/callback/github)
NUXT_PUBLIC_APP_BASE_URL=http://localhost:3000
# Compose host mappings and reusable application image tag
APP_PORT=3000
POSTGRES_PORT=5432
APP_IMAGE=nuxt-starter:local
# Server-only pg-boss settings. Runtime never applies migrations automatically.
PGBOSS_SCHEMA=pgboss
JOBS_CONCURRENCY=4
PGBOSS_USE_LISTEN_NOTIFY=false
# Optional server observability. An empty endpoint means no external network export.
LOG_LEVEL=info
OTEL_SERVICE_NAME=
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_RESOURCE_ATTRIBUTES=
# Optional per-signal URLs; unlike the common endpoint, include /v1/traces or /v1/metrics.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# Safe metadata only: never put credentials in these fields.
APP_VERSION=unknown
APP_REVISION=unknown
DEPLOYMENT_ENVIRONMENT=development
# Optional server-only storage. No backend/config is required merely to boot/build.
# Explicit local bootstrap: bun run storage:dev:rustfs (or storage:dev:garage).
# Copy the matching development credentials from the optional Compose configuration.
STORAGE_BUCKET=
# Required on use: STORAGE_REGION -> AWS_REGION -> AWS_DEFAULT_REGION (no default).
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_SESSION_TOKEN=
# Unset defaults to true for custom endpoints, false for AWS S3.
# STORAGE_FORCE_PATH_STYLE=true
STORAGE_PRESIGN_TTL_SECONDS=600
STORAGE_KEY_PREFIX=
# Optional GitHub OAuth
NUXT_GITHUB_CLIENT_ID=
NUXT_GITHUB_CLIENT_SECRET=
# Optional generic OIDC (callback: /api/auth/callback/oidc)
NUXT_OIDC_ISSUER=
NUXT_OIDC_CLIENT_ID=
NUXT_OIDC_CLIENT_SECRET=
# Optional SMTP-backed magic links; structural SMTP config required when enabled.
NUXT_MAGIC_LINK_ENABLED=false
# Mirrors the non-secret capability flag for rendering the optional form.
NUXT_PUBLIC_MAGIC_LINK_ENABLED=false
# Only read by auth:provision; never exposed to the app
DEV_OIDC_ADMIN_URL=
DEV_OIDC_API_KEY=
APP_BASE_URL=http://localhost:3000

# Optional Email: required only on use. Local Mailpit example (sink only).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO_ADDRESS=
EMAIL_REPLY_TO_NAME=
EMAIL_MAX_RECIPIENTS=50

# Optional server-only Cache. Configure only on first use; never log CACHE_URL.
# cache:dev:valkey starts disposable loopback Valkey (no persistence/volume).
CACHE_URL=
CACHE_KEY_PREFIX=app
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_MAX_VALUE_BYTES=1048576

# Realtime: SSE (default), WebSocket, or Both; server-only transport selection.
# Both uses sse,websocket. WebSocket v1 carries events, not generic RPC.
REALTIME_TRANSPORTS=sse

# Optional ntfy notification delivery: explicit trusted server root, never public default.
# Supply an application-owned current recipient-to-topic resolver before use.
NTFY_BASE_URL=
NTFY_TOKEN=
NTFY_TIMEOUT_SECONDS=10

# Optional AI, server-only; required model is read only when AI is used.
AI_PROVIDER=openai-compatible
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=60

# Optional Import / Export limits; server-only, lazy on transfer operations.
IMPORT_EXPORT_MAX_BYTES=16777216
IMPORT_EXPORT_MAX_ROWS=10000
IMPORT_EXPORT_TIMEOUT_SECONDS=60
IMPORT_EXPORT_ARTIFACT_TTL_SECONDS=86400

# Privileged read-only platform operators: server-only baseline user IDs, default deny.
OPS_ADMIN_USER_IDS=

# Optional Admin-only Medusa2.21.2. No provider calls/config checks at startup.
MEDUSA_BASE_URL=
MEDUSA_SECRET_API_KEY=
MEDUSA_BRIDGE_WEBHOOK_SECRET=
MEDUSA_BRIDGE_WEBHOOK_SECRET_PREVIOUS=
