# Server-only: PostgreSQL connection and Better Auth signing secret (32+ characters)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nuxt_starter
NUXT_AUTH_SECRET=replace-with-a-random-value-at-least-32-characters-long
# Public origin used for OAuth callbacks (GitHub callback: /api/auth/callback/github)
NUXT_PUBLIC_APP_BASE_URL=http://localhost:3000
# Optional GitHub OAuth
NUXT_GITHUB_CLIENT_ID=
NUXT_GITHUB_CLIENT_SECRET=
# Optional generic OIDC (callback: /api/auth/callback/oidc)
NUXT_OIDC_ISSUER=
NUXT_OIDC_CLIENT_ID=
NUXT_OIDC_CLIENT_SECRET=
# Optional development-only console magic links. Provide a real sender before production.
NUXT_MAGIC_LINK_ENABLED=false
# Mirrors the non-secret capability flag for rendering the optional form.
NUXT_PUBLIC_MAGIC_LINK_ENABLED=false
# Only read by auth:provision; never exposed to the app
DEV_OIDC_ADMIN_URL=
DEV_OIDC_API_KEY=
APP_BASE_URL=http://localhost:3000
