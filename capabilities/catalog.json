{
  "$schema": "./catalog.schema.json",
  "schemaVersion": 1,
  "referenceApplication": {
    "enabledCapabilities": [
      "jobs",
      "api-platform",
      "observability",
      "object-storage",
      "email",
      "webhooks",
      "audit-log",
      "cache-coordination",
      "realtime",
      "notifications",
      "search",
      "ai",
      "import-export",
      "ops-admin"
    ]
  },
  "baseline": [
    {
      "id": "framework",
      "displayName": "Nuxt framework",
      "summary": "Nuxt 4 with Vue and Nitro routing, SSR, and server APIs."
    },
    {
      "id": "strict-typescript",
      "displayName": "Strict TypeScript",
      "summary": "Strict TypeScript checks across application and server code."
    },
    {
      "id": "bun-tooling",
      "displayName": "Bun tooling",
      "summary": "Pinned Bun package management and repository scripts."
    },
    {
      "id": "node-runtime",
      "displayName": "Node production runtime",
      "summary": "Portable Nitro Node output is the production runtime contract."
    },
    {
      "id": "postgresql",
      "displayName": "PostgreSQL",
      "summary": "PostgreSQL 18 is the baseline relational database."
    },
    {
      "id": "drizzle",
      "displayName": "Drizzle",
      "summary": "Drizzle ORM and committed SQL migrations provide typed database access."
    },
    {
      "id": "authentication",
      "displayName": "Better Auth",
      "summary": "Database-backed sessions with password authentication disabled."
    },
    {
      "id": "github-oauth",
      "displayName": "GitHub OAuth",
      "summary": "Optional GitHub sign-in is part of the base authentication contract."
    },
    {
      "id": "oidc",
      "displayName": "Generic OIDC",
      "summary": "Provider-neutral OIDC sign-in is part of the base authentication contract."
    },
    {
      "id": "pocket-id-provisioning",
      "displayName": "Pocket ID provisioning",
      "summary": "Development-only idempotent Pocket ID client provisioning."
    },
    {
      "id": "tailwind",
      "displayName": "Tailwind CSS",
      "summary": "Tailwind CSS 4 provides baseline styling."
    },
    {
      "id": "component-system",
      "displayName": "shadcn-style components",
      "summary": "shadcn-vue conventions and Reka UI primitives form the component baseline."
    },
    {
      "id": "icons",
      "displayName": "Tabler Icons",
      "summary": "Tabler Icons is the baseline icon system."
    },
    {
      "id": "container-orchestration",
      "displayName": "Docker and Compose",
      "summary": "Provider-neutral production image and Compose orchestration."
    },
    {
      "id": "migrations",
      "displayName": "Explicit migrations",
      "summary": "Schema changes are explicit release operations, never runtime startup effects."
    },
    {
      "id": "ci-testing",
      "displayName": "CI and testing",
      "summary": "Lint, typecheck, Vitest, Playwright, builds, and container smoke run in CI."
    },
    {
      "id": "agent-scaffolding",
      "displayName": "Agent scaffolding",
      "summary": "Repository context, prompts, and focused skills guide maintenance."
    }
  ],
  "capabilities": [
    {
      "id": "jobs",
      "displayName": "Jobs",
      "kind": "foundational-backend",
      "status": "done",
      "defaultInstalled": false,
      "requires": [],
      "integratesWith": [
        "observability",
        "ops-admin"
      ],
      "baselineRequirements": [
        "postgresql"
      ],
      "externalRequirements": [
        {
          "name": "PostgreSQL",
          "required": true
        }
      ],
      "summary": "Typed pg-boss jobs with bounded concurrency, explicit producer/worker/migration roles, same-database transactions and native attempt context.",
      "scripts": [
        "jobs:worker",
        "jobs:migrate",
        "jobs:doctor",
        "jobs:smoke",
        "packages:build",
        "packages:test"
      ],
      "environmentVariables": [
        "DATABASE_URL",
        "PGBOSS_DATABASE_URL",
        "PGBOSS_SCHEMA",
        "JOBS_CONCURRENCY",
        "PGBOSS_USE_LISTEN_NOTIFY"
      ],
      "migrations": [
        "Explicit pg-boss schema migration via jobs:migrate"
      ],
      "runtimeProcesses": [
        "worker",
        "migrate (one-shot)"
