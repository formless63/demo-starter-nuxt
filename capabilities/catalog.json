        "runtimeScript": "package:test:runtime",
        "removal": {
          "scripts": [
            "jobs:migrate",
            "jobs:doctor",
            "jobs:worker",
            "jobs:smoke",
            "package:test:runtime"
          ],
          "paths": [
            "server/jobs",
            "server/api/jobs.post.ts"
          ],
          "replacementNuxtConfig": ".fixture/base-nuxt.config.ts"
        }
      }
