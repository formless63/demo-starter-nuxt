{
  "name": "@repo/nuxt-medusa",
  "version": "0.1.0",
  "description": "Scoped Admin-only Medusa reconciliation and application bridge",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    },
    "./server": {
      "types": "./dist/runtime/server/index.d.ts",
      "import": "./dist/runtime/server/index.js",
      "default": "./dist/runtime/server/index.js"
    },
    "./schema": {
      "types": "./dist/runtime/server/schema.d.ts",
      "import": "./dist/runtime/server/schema.js",
      "default": "./dist/runtime/server/schema.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "server": [
        "./dist/runtime/server/index.d.ts"
      ],
      "schema": [
        "./dist/runtime/server/schema.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "provider-bridge"
  ],
  "scripts": {
    "dev:prepare": "nuxt-module-build prepare && nuxt-module-build build",
    "prepack": "nuxt-module-build prepare && nuxt-module-build build"
  },
  "dependencies": {
    "@nuxt/kit": "4.5.2"
  },
  "peerDependencies": {
    "nuxt": ">=4.0.0 <5",
    "@repo/nuxt-jobs": ">=0.1.0 <0.2",
    "drizzle-orm": ">=0.45.0 <1",
    "zod": ">=4.0.0 <5",
    "@repo/nuxt-webhooks": ">=0.1.0 <0.2",
    "h3": ">=1.15.11 <2"
  },
  "devDependencies": {
    "@nuxt/module-builder": "1.0.3",
    "nuxt": "4.5.2",
    "@repo/nuxt-jobs": "workspace:*",
    "drizzle-orm": "0.45.3",
    "zod": "4.6.5",
    "@repo/nuxt-webhooks": "workspace:*",
    "h3": "1.15.11"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
