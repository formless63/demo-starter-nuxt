{
  "name": "@repo/nuxt-webhooks",
  "version": "0.1.0",
  "description": "Signed webhooks with Jobs-backed durable delivery for Nuxt",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./server": {
      "types": "./dist/runtime/server/index.d.ts",
      "import": "./dist/runtime/server/index.js"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "server": [
        "./dist/runtime/server/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev:prepare": "nuxt-module-build prepare && nuxt-module-build build",
    "prepack": "nuxt-module-build prepare && nuxt-module-build build"
  },
  "dependencies": {
    "@nuxt/kit": "4.5.2"
  },
  "peerDependencies": {
    "@repo/nuxt-jobs": ">=0.1.0 <0.2",
    "nuxt": ">=4.0.0 <5",
    "zod": ">=4.0.0 <5"
  },
  "devDependencies": {
    "@nuxt/module-builder": "1.0.3",
    "@repo/nuxt-jobs": "workspace:*",
    "nuxt": "4.5.2",
    "zod": "4.6.5"
  }
}
