{
  "name": "@repo/nuxt-jobs",
  "version": "0.1.0",
  "description": "Typed PostgreSQL-backed jobs for Nuxt applications",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./server": {
      "types": "./dist/runtime/server/index.d.ts",
      "import": "./dist/runtime/server/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "import": "./dist/cli.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "server": [
        "./dist/runtime/server/index.d.ts"
      ],
      "cli": [
        "./dist/cli.d.mts"
      ]
    }
  },
  "bin": {
    "nuxt-jobs": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev:prepare": "nuxt-module-build prepare && nuxt-module-build build",
    "prepack": "nuxt-module-build prepare && nuxt-module-build build"
  },
  "dependencies": {
    "@nuxt/kit": "4.5.2",
    "jiti": "2.7.0",
    "pg-boss": "12.35.0"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.0 <1",
    "nuxt": ">=4.0.0 <5",
    "zod": ">=4.0.0 <5"
  },
  "devDependencies": {
    "@nuxt/module-builder": "1.0.3",
    "drizzle-orm": "0.45.3",
    "nuxt": "4.5.2",
    "zod": "4.6.5"
  }
}
