{
  "name": "@repo/nuxt-data-table",
  "version": "0.1.0",
  "description": "Accessible, controlled Nuxt data tables powered by TanStack Table",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/types.d.mts", "import": "./dist/module.mjs", "default": "./dist/module.mjs" }, "./runtime": { "types": "./dist/runtime/index.d.ts", "import": "./dist/runtime/index.js", "default": "./dist/runtime/index.js" } },
  "main": "./dist/module.mjs",
  "files": ["dist"],
  "scripts": { "dev:prepare": "nuxt-module-build prepare && nuxt-module-build build", "prepack": "nuxt-module-build prepare && nuxt-module-build build" },
  "dependencies": { "@nuxt/kit": "4.5.2", "@tanstack/vue-table": "9.2.4" },
  "peerDependencies": { "nuxt": ">=4.0.0 <5" },
  "devDependencies": { "@nuxt/module-builder": "1.0.3", "nuxt": "4.5.2", "vue": "3.5.43" }
}
