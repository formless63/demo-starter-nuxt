{
  "name": "@repo/nuxt-api",
  "version": "0.1.0",
  "description": "Machine authentication and OpenAPI contracts for Nuxt applications",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    },
    "./server": {
      "types": "./dist/runtime/server/index.d.ts",
      "import": "./dist/runtime/server/index.js",
      "default": "./dist/runtime/server/index.js"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": ["./dist/types.d.mts"],
      "server": ["./dist/runtime/server/index.d.ts"]
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev:prepare": "nuxt-module-build prepare && nuxt-module-build build",
    "prepack": "nuxt-module-build prepare && nuxt-module-build build"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.7",
    "@nuxt/kit": "4.5.2",
    "@scalar/nuxt": "0.6.75",
    "h3": "1.15.11",
    "zod-openapi": "6.0.2"
  },
  "peerDependencies": {
    "better-auth": ">=1.7.0 <2",
    "drizzle-orm": ">=0.45.0 <1",
    "nuxt": ">=4.0.0 <5",
    "zod": ">=4.0.0 <5"
  },
  "devDependencies": {
    "@nuxt/module-builder": "1.0.3",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "nuxt": "4.5.2",
    "zod": "4.6.5"
  }
}
