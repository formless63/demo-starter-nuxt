{
  "name": "@repo/nuxt-pwa-offline",
  "version": "0.1.0",
  "private": true,
  "description": "Opt-in native Nuxt public-only offline notice and safe service-worker lifecycle",
  "type": "module",
  "main": "./dist/module.mjs",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    },
    "./client": {
      "types": "./dist/runtime/client.d.ts",
      "import": "./dist/runtime/client.js"
    },
    "./policy": {
      "types": "./dist/runtime/policy.d.ts",
      "import": "./dist/runtime/policy.js"
    },
    "./constants": {
      "types": "./dist/runtime/constants.d.ts",
      "import": "./dist/runtime/constants.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:prepare": "nuxt-module-build prepare && nuxt-module-build build",
    "prepack": "nuxt-module-build prepare && nuxt-module-build build"
  },
  "dependencies": {
    "@nuxt/kit": "4.5.2",
    "@vite-pwa/nuxt": "1.1.1",
    "vite-plugin-pwa": "1.3.0",
    "workbox-build": "7.4.1"
  },
  "peerDependencies": {
    "nuxt": ">=4.0.0 <5",
    "vue": ">=3.5.0 <4"
  },
  "devDependencies": {
    "@nuxt/module-builder": "1.0.3",
    "nuxt": "4.5.2"
  }
}
