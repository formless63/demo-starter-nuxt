{
  "name": "@repo/nuxt-storage",
  "version": "0.1.0",
  "private": true,
  "description": "Private server-only S3 primitives for Nuxt",
  "type": "module",
  "main": "./dist/module.mjs",
  "exports": {
    ".": { "types": "./dist/types.d.mts", "import": "./dist/module.mjs", "default": "./dist/module.mjs" },
    "./server": { "types": "./dist/runtime/server/index.d.ts", "import": "./dist/runtime/server/index.js", "default": "./dist/runtime/server/index.js" },
    "./testing": { "types": "./dist/runtime/server/smoke.d.ts", "import": "./dist/runtime/server/smoke.js", "default": "./dist/runtime/server/smoke.js" }
  },
  "typesVersions": { "*": { ".": ["./dist/types.d.mts"], "server": ["./dist/runtime/server/index.d.ts"], "testing": ["./dist/runtime/server/smoke.d.ts"] } },
  "files": ["dist"],
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev:prepare": "nuxt-module-build prepare && nuxt-module-build build",
    "prepack": "nuxt-module-build prepare && nuxt-module-build build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@aws-sdk/s3-request-presigner": "3.1143.0",
    "@nuxt/kit": "4.5.2"
  },
  "peerDependencies": { "nuxt": ">=4.0.0 <5" },
  "devDependencies": { "@nuxt/module-builder": "1.0.3", "nuxt": "4.5.2" }
}
