    "zod": "4.6.5",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vue-tsc": "3.1.7",
    "@types/node": "24.10.1",
    "drizzle-kit": "0.31.11",
    "@types/pg": "8.15.6"
  }
